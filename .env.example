# ============================================================
# NuevaMente — variables de entorno (Fase 6 del Plan Técnico)
# Sin secretos. Copiar como .env cuando exista implementación real.
# ============================================================

APP_NAME=NuevaMente
ENVIRONMENT=development

# Ingesta (DT-12, RF-001)
MAX_FILE_SIZE_MB=10

# Processing (TASK-002)
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# RAG (BE-RAG-009/010)
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.25

# Validación de fidelidad (DT-11)
FIDELITY_THRESHOLD=0.90

# Proveedores de IA — DT-09, 🔴 bloqueante (no confirmado formalmente)
LLM_PROVIDER=mock
EMBEDDING_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_EMBEDDING_MODEL=

LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1

# Vector Store (DT-02)
CHROMA_PERSIST_DIR=./data/chroma

# OCI Object Storage (DT-07, REQ-18)
OCI_CONFIG_FILE=~/.oci/config
OCI_PROFILE=DEFAULT
OCI_NAMESPACE=
OCI_BUCKET_NAME=bucket-20260921-2152-nuevamente-docs-test
OCI_PREFIX=

# Persistencia de sesión (DT-08)
DATABASE_URL=sqlite:///./data/sqlite/nuevamente.db