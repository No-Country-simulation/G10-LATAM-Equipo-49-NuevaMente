# ============================================================
# NuevaMente — variables de entorno (Fase 6 del Plan Técnico)
# Sin secretos. Copiar como .env cuando exista implementación real.
# ============================================================


# Opcional: copia este archivo como ".env" en la raíz solo si quieres cambiar algo.
# Sin ".env" todo funciona con los valores por defecto.

APP_NAME=NuevaMente
# *****************************************************************************
#  MEJORA AUD-021 — 2026-10-15
#  `.env.example` omitía variables de `Settings` (`APP_VERSION`,
#  `EMBEDDING_DIMENSIONS`, `VECTORSTORE_PROVIDER`) y dejaba el modelo Gemini
#  vigente solo comentado; ahora se listan explícitamente para que este archivo
#  sea la única fuente de verdad de la configuración.
# *****************************************************************************
APP_VERSION=0.1.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# Quién puede llamar a la API desde un navegador (formato JSON).
# Por defecto solo la futura interfaz Streamlit (puerto 8501). Para abrirlo a
# cualquier origen: CORS_ORIGINS=["*"]
CORS_ORIGINS=["http://localhost:8501","http://127.0.0.1:8501"]


# Ingesta (DT-12, RF-001)
MAX_FILE_SIZE_MB=10


# Processing (TASK-002)
# Partición del texto en fragmentos
CHUNK_SIZE=800
CHUNK_OVERLAP=150
MAX_DOCUMENT_CHARS=2000000

# RAG (BE-RAG-009/010)
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.25

# Validación de fidelidad (DT-11)
FIDELITY_THRESHOLD=0.90

# Proveedores de IA — DT-09
# Descomenta para usar Gemini (requiere GEMINI_API_KEY válida)
# LLM_PROVIDER=gemini
# EMBEDDING_PROVIDER=gemini
# GEMINI_API_KEY=tu_api_key_aqui
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Descomenta para usar Cohere (requiere COHERE_API_KEY válida)
# LLM_PROVIDER=cohere
# EMBEDDING_PROVIDER=cohere
# COHERE_API_KEY=tu_api_key_aqui
# COHERE_MODEL=command-r-plus
# COHERE_EMBEDDING_MODEL=embed-multilingual-v3.0
# COHERE_EMBEDDING_DIMENSIONS=1024


# Por defecto usa mock (sin credenciales, sin red)
LLM_PROVIDER=mock
EMBEDDING_PROVIDER=mock
GEMINI_API_KEY=
COHERE_API_KEY=

# Dimensión del modelo de embeddings activo (gemini/cohere/openai/custom). El
# proveedor mock usa su propia dimensión fija (256) y no lee esta variable.
# Para `openai`/`custom` DEBE ser la dimensión real del modelo configurado.
EMBEDDING_DIMENSIONS=768

# Proveedor compatible con OpenAI y registro de proveedor propio (opcionales;
# se usan solo si LLM_PROVIDER/EMBEDDING_PROVIDER valen "openai" o "custom").
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MAX_TOKENS=4096
LLM_JSON_MODE=true
EMBEDDING_MODEL=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
LLM_PROVIDER_CLASS=
EMBEDDING_PROVIDER_CLASS=

LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1

# Vector Store (DT-02)
# `chroma` = índice persistente (por defecto) · `memory` = solo tests/desarrollo
VECTORSTORE_PROVIDER=chroma
CHROMA_PERSIST_DIR=./data/chroma

# Dónde se guardan los archivos: mock = carpeta local · oci = Oracle Cloud
STORAGE_PROVIDER=mock
MOCK_STORAGE_DIR=./data/mock_oci

# OCI Object Storage (DT-07, REQ-18)
OCI_CONFIG_FILE=~/.oci/config
OCI_PROFILE=DEFAULT
OCI_NAMESPACE=
OCI_BUCKET_NAME=nuevamente-docs   # sobrescribe con el nombre de tu bucket real

# Persistencia de sesión (DT-08)
# Base de datos local
DATABASE_URL=sqlite:///./data/sqlite/nuevamente.db
