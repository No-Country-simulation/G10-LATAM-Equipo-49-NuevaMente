FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app/nuevamente/ui

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY nuevamente/backend/requirements.txt ../backend/
RUN pip install -r ../backend/requirements.txt

COPY nuevamente/backend/requirements-dev.txt ../backend/
RUN pip install -r ../backend/requirements-dev.txt

COPY nuevamente/ui/ ./

EXPOSE 8501

CMD ["streamlit", "run", "app.py", "--server.port=8501", "--server.headless=true", "--server.address=0.0.0.0"]